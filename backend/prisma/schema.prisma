generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String
  role              Role                @default(USER)
  isEmailVerified   Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  avatarUrl         String?
  name              String?
  points            Int                 @default(0)
  university        String?
  pomodoroMinutes   Int                 @default(0)
  answers           Answer[]
  comments          Comment[]
  flashcardProgress FlashcardProgress[]
  notes             Note[]
  favoriteNotes     NoteFavorite[]
  questions         Question[]
  reports           Report[]
}

model Question {
  id         String   @id @default(uuid())
  content    String
  fileUrl    String?
  fileType   String?
  course     String
  topic      String
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isResolved Boolean  @default(false)
  answers    Answer[]
  user       User?    @relation(fields: [userId], references: [id])
}

model Answer {
  id         String   @id @default(uuid())
  content    String
  fileUrl    String?
  fileType   String?
  userId     String?
  questionId String
  isCorrect  Boolean  @default(false)
  isSpam     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
}

model Note {
  id          String         @id @default(uuid())
  courseName  String
  schoolName  String
  description String?
  fileUrl     String
  fileSize    Int
  mimeType    String
  userId      String?
  isHidden    Boolean        @default(false)
  needsReview Boolean        @default(false)
  isVerified  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  aiSummary   String?
  comments    Comment[]
  flashcards  Flashcard[]
  user        User?          @relation(fields: [userId], references: [id])
  favorites   NoteFavorite[]
  reports     Report[]
}

model NoteFavorite {
  id     String @id @default(uuid())
  userId String
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
}

model Report {
  id        String   @id @default(uuid())
  userId    String
  noteId    String
  reason    String
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  userId    String?
  noteId    String
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

model Flashcard {
  id        String              @id @default(uuid())
  front     String
  back      String
  noteId    String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  note      Note                @relation(fields: [noteId], references: [id], onDelete: Cascade)
  progress  FlashcardProgress[]
}

model FlashcardProgress {
  id          String    @id @default(uuid())
  userId      String
  flashcardId String
  isKnown     Boolean   @default(false)
  updatedAt   DateTime  @updatedAt
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
}

enum Role {
  USER
  ADMIN
}
